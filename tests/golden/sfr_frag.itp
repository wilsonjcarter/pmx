; Synthetic CH3-capped side-chain fragment for the ITP front end golden case.
; A serine-like side chain (CB-OG-HG) with a CH3 cap standing in for the CA
; backbone attachment.  _find_methyl_cap picks CT (3 H, one non-H neighbour) as
; the cap; its neighbour CA becomes the alpha carbon; the backbone (N/C/O/HN) is
; grafted from the host residue.  Atom types are stock CHARMM so every bonded
; term resolves at gentop.  Used by generate_golden.py:nsaa__leu2sfr_itp.
[ atoms ]
;  nr  type  resnr res  name cgnr  charge   mass
   1   CT3   1     SFR  CT   1     0.000   12.011
   2   HA3   1     SFR  HT1  1     0.090    1.008
   3   HA3   1     SFR  HT2  1     0.090    1.008
   4   HA3   1     SFR  HT3  1     0.090    1.008
   5   CT1   1     SFR  CA   2     0.070   12.011
   6   HB1   1     SFR  HA   2     0.090    1.008
   7   CT2   1     SFR  CB   3     0.050   12.011
   8   HA2   1     SFR  HB1  3     0.090    1.008
   9   HA2   1     SFR  HB2  3     0.090    1.008
  10   OH1   1     SFR  OG   4    -0.660   15.999
  11   H     1     SFR  HG   4     0.430    1.008
[ bonds ]
   1  2
   1  3
   1  4
   1  5
   5  6
   5  7
   7  8
   7  9
   7 10
  10 11
