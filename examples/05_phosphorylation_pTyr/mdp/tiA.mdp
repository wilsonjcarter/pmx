
; VARIOUS PREPROCESSING OPTIONS
title                    =
include                  =
define                   = ;-DPOSRES

integrator               = sd
tinit                    = 0
dt                       = 0.002
nsteps                   = 50000

ld_seed			             = -1
init_step                = 0
comm-mode                = Linear
nstcomm                  = 100
nstcalcenergy		         = 1
nstdhdl                  = 1
comm-grps                =

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstcheckpoint            = 10000
nstlog                   = 25000
nstenergy                = 25000
nstxtcout                = 50000
xtc-precision            = 1000
xtc-grps                 =
energygrps               =

cutoff-scheme 		       = verlet
nstlist                  = 20
ns-type                  = Grid
pbc                      = xyz
rlist                    = 1.2
domain-decomposition     = no


coulombtype              = PME
rcoulomb                 = 1.1

vdwtype                  = Cut-off
vdw-modifier             = Force-switch
rvdw-switch              = 1.0
rvdw                     = 1.1



tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 2.0
ref-t                    = 298

Pcoupl                   = C-rescale
Pcoupltype               = Isotropic
tau-p                    = 5
compressibility          = 4.6E-5
ref-p                    = 1


gen-vel                  = no
gen-temp                 = 298
gen-seed                 = -1

constraints              = hbonds
constraint-algorithm     = Lincs


free-energy              = yes
init-lambda              = 0
delta-lambda             = 0.00002
sc-alpha                 = 0.3
sc-sigma                 = 0.25
sc-power                 = 1
sc-coul                  = yes
sc-function              = gapsys



refcoord-scaling = com
