;=======================================================================
;  .mdp file for energy minimization
;=======================================================================
integrator     = steep
nsteps         = 5000
;
; Interactions and neighbours:
;------------------------------
;
nstlist        = 1
cutoff-scheme  = verlet
vdw-type       = cut-off
rvdw           = 1.0
coulombtype    = cut-off
rcoulomb       = 1.0
pbc            = xyz
;=======================================================================


; Free energy control stuff
free-energy              = yes
init-lambda              = 0.5
delta-lambda             = 0
sc-alpha                 = 0.3
sc-sigma                 = 0.25
sc-power                 = 1
sc-coul                  = yes
sc-function              = gapsys
