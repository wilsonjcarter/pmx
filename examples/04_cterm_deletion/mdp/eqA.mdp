
; VARIOUS PREPROCESSING OPTIONS
title                    =
include                  =
define                   = ;-DPOSRES

integrator               = sd
tinit                    = 0
dt                       = 0.002
nsteps                   = 7500000

comm-mode                = Linear
nstcomm                  = 100
nstcalcenergy		         = 100
nstdhdl			             = 1000
comm-grps                =
constraints = h-bonds


nstxout                  = 50000
nstvout                  = 50000
nstfout                  = 0

nstcheckpoint            = 1000
nstlog                   = 500000
nstenergy                = 500000
nstxtcout                = 0
xtc-precision            = 1000



cutoff-scheme 		       = verlet
nstlist                  = 30
ns-type                  = Grid
pbc                      = xyz
rlist                    = 1.2
domain-decomposition     = no

coulombtype              = PME
rcoulomb                 = 1.1


vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0
rvdw                     = 1.1
DispCorr                 = no


tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 2.0
ref-t                    = 298

Pcoupl                   = C-rescale
Pcoupltype               = Isotropic
tau-p                    = 5
compressibility          = 4.6E-5
ref-p                    = 1

gen-vel                  = yes
gen-temp                 = 298
gen-seed                 = -1

free-energy              = yes
init-lambda              = 0
delta-lambda             = 0
sc-alpha                 = 0.3
sc-sigma                 = 0.25
sc-power                 = 1
sc-coul 		             = yes
sc-function		           = gapsys


refcoord-scaling 	     = com
