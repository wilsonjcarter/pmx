; Residue-specific bonded parameters for the residues in glycation.rtp.
; Copied VERBATIM from charmm36-jul2022.ff/ffbonded.itp, taking only lines whose
; OWN comment carries a word-boundary KCX tag -- nothing derived or analogised,
; and no substring false positives (stock also has unrelated "NABAKB" lines).
;
; KCX is Lys carboxylated at NZ, so it needs the carbamate N-C(=O)O terms
; NG2S1-CG2O3 and the angles/dihedrals around it.  Without the bond, KCX could
; not be built at all.  Same class of gap as CSO, KS0 and ABA -- see
; tests/test_residue_params_complete.py, which now enforces the invariant.
; Only the entries this tree lacks are written, so no directive is duplicated.
;
; NOTE: pmx ffparser applies ONE format to a whole [ dihedraltypes ] section
; (parseList tries ssssiffffff, ssssiffi, ssiffi, ssssiff in turn), so a section
; holding a MIX of shapes matches none and the parse dies with "Cannot convert
; line into format".  Each shape therefore gets its own directive block.

[ bondtypes ]   ; shape ssiff
   CG2O3    NG2S1     1   0.13450000    309616.00 ; from CG2O1 NG2S1, PENALTY= 10 CXM KCX

[ angletypes ]   ; shape sssiffff
   NG2S1    CG2O3    OG2D2     5   105.910000   665.088640   0.00000000         0.00 ; KCX, by ac_aa
   CG2O3    NG2S1    CG321     5   120.000000   418.400000   0.00000000         0.00 ; from CG2O1 NG2S1 CG321, penalty= 7.5 KCX
   CG2O3    NG2S1     HGP1     5   123.000000   284.512000   0.00000000         0.00 ; from CG2O1 NG2S1 HGP1, penalty= 7.5 KCX CXM

[ dihedraltypes ]   ; shape ssssiff
   CG2O3    OG2D2    OG2D2    NG2S1     2     0.000000   461.029102  ; KCX, by ac_aa

[ dihedraltypes ]   ; shape ssssiffi
   OG2D2    CG2O3    NG2S1    CG321     9     0.000000     6.496915     1 ; KCX, by ac_aa
   OG2D2    CG2O3    NG2S1    CG321     9   180.000000     8.929911     2 ; KCX, by ac_aa
   OG2D2    CG2O3    NG2S1    CG321     9     0.000000     2.026730     3 ; KCX, by ac_aa
   OG2D2    CG2O3    NG2S1    CG321     9     0.000000     0.509193     6 ; KCX, by ac_aa
   OG2D2    CG2O3    NG2S1     HGP1     9   180.000000     2.736754     1 ; KCX, by ac_aa
   OG2D2    CG2O3    NG2S1     HGP1     9     0.000000     0.971943     3 ; KCX, by ac_aa
   CG321    CG321    NG2S1    CG2O3     9     0.000000     7.531200     1 ; from CG321 CG321 NG2S1 CG2O1, penalty= 7.5 KCX
    HGA2    CG321    NG2S1    CG2O3     9     0.000000     0.000000     3 ; from HGA2 CG321 NG2S1 CG2O1, penalty= 7.5 KCX
    CTD1    CG321    CG321    CG321     9     0.000000     2.092000     3 ; CARBOCY carbocyclic sugars MCL ALY 26P 6CL HHK KCX HRG IT1 LDO
    CTD1    CG321    CG321    CG321     9   180.000000     2.092000     6 ; CARBOCY carbocyclic sugars MCL ALY 26P 6CL HHK KCX HRG IT1 LDO
