       HA      HB1  0.0900   1
       CB    CG321 -0.1800   2
      HB1     HGA2  0.0900   2
      HB2     HGA2  0.0900   2
       CG    CG321 -0.1800   3
      HG1     HGA2  0.0900   3
      HG2     HGA2  0.0900   3
       CD    CG321 -0.1800   4
      HD1     HGA2  0.0900   4
      HD2     HGA2  0.0900   4
