; NOS / SONOS / sulfenic bonded parameters needed by the CN0/KN0/KS0 cross-link
; endpoints in nos.rtp.  Ported from charmm36m-mut.ff/nos_bonded.itp on 2026-09-30.
;
; This is deliberately a SUBSET: 20 of that file's 41 entries are already carried by
; this tree (7 of them as MULTI-LINE type-9 dihedral blocks), and a duplicated
; multi-line dihedral block is a HARD grompp error -- "Encountered a second block of
; parameters for dihedral type 9 for the same atom types".  Only the 31 entries this
; tree lacks are here.  Charges are NOT ECC-scaled and must not be: CN0/KN0 carry
; fractional net charges that sum to zero across the pair (-0.154/+0.154), i.e. a
; neutral covalent bridge rather than an ionic group, and this tree keeps neutral
; residues byte-identical to the plain tree (verified on CSO/CYS/LSN; only formally
; ionic ones are scaled, CYM -1->-0.75, LYS +1->+0.75).

[ bondtypes ]
   CT2    NG311  1   0.14740    220078.40  ; CG321-NG311 (CE-NZ)
   CT2    SG301  1   0.18160    179075.20  ; CG321-SG301 (CB-SG)

[ angletypes ]
   CT2    NG311  OG301  5   103.80    578.229  0.0   0.0     ; CE-NZ-OD  OPTIMISED Jun15
   CT2    CT2    NG311  5   110.00    365.682  0.0   0.0     ; CD-CE-NZ  <-CG321CG321NG311
   HA2    CT2    NG311  5   109.50    271.123  0.2130 418.40 ; HE-CE-NZ  <-NG311CG321HGA2 (w/UB)
   CT2    NG311  HGP1   5   111.00    384.928  0.0   0.0     ; CE-NZ-HZ  <-CG321NG311HGP1
   CT1    CT2    SG301  5   112.50    485.344  0.0   0.0     ; CA-CB-SG  <-CHARMM S-CT2-CT1
   HA2    CT2    SG301  5   111.00    317.984  0.0   0.0     ; HB-CB-SG  <-SG301CG321HGA2
   CT2    SG301  OG311  5    99.37    582.580  0.0   0.0     ; CB-SG-OD sulfenic <-CG321SG301OG311
   CT2    SG301  OG301  5   101.70    431.036  0.0   0.0     ; CB-SG-OD nos <-CG321SG301OG301

