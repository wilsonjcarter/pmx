; glycation.rtp -- ported from charmm36m-mut 2026-10-05.
; ECC scales the charges of a CHARGED side chain by 0.75 and leaves the
; backbone (N HN CA HA C O) alone; a neutral residue is copied verbatim,
; which is exactly how the existing tree treats ALA/SER/ASN/... (they are
; byte-identical between the two trees).
; Net charge after scaling: a -1 side chain becomes -0.75, matching ASP/GLU.

[ bondedtypes ]
; Col 1: Type of bond
; Col 2: Type of angles
; Col 3: Type of proper dihedrals
; Col 4: Type of improper dihedrals
; Col 5: Generate all dihedrals if 1, only heavy atoms of 0.
; Col 6: Number of excluded neighbors for nonbonded interactions
; Col 7: Generate 1,4 interactions between pairs of hydrogens if 1
; Col 8: Remove propers over the same bond as an improper if it is 1
; bonds  angles  dihedrals  impropers all_dihedrals nrexcl HH14 RemoveDih
     1       5          9        2        1           3      1     0


[ KCX ]
; lysine NZ-carboxylic acid
  [ atoms ]
        N      NH1 -0.4700   1
       HN        H  0.3100   1
       CA      CT1  0.0700   1
       HA      HB1  0.0900   1
       CB    CG321 -0.1350   2
      HB1     HGA2  0.0675   2
      HB2     HGA2  0.0675   2
       CG    CG321 -0.1350   3
      HG1     HGA2  0.0675   3
      HG2     HGA2  0.0675   3
       CD    CG321 -0.1350   4
      HD1     HGA2  0.0675   4
      HD2     HGA2  0.0675   4
       CE    CG321 -0.0345   5
      HE1     HGA2  0.0675   5
      HE2     HGA2  0.0675   5
       NZ    NG2S1 -0.4950   5
       HZ     HGP1  0.1432   5
       CX    CG2O3  0.5827   5
      OQ1    OG2D2 -0.5407   5
      OQ2    OG2D2 -0.5407   5
        C        C  0.5100   6
        O        O -0.5100   6
  [ bonds ]
        N    CA
        C    CA
        C    +N
       CA    HA
       CA    CB
        N    HN
       CB   HB1
       CB   HB2
       CB    CG
       CG   HG1
       CG   HG2
       CG    CD
       CD   HD1
       CD   HD2
       CD    CE
       CE   HE1
       CE   HE2
       CE    NZ
       NZ    HZ
       NZ    CX
       CX   OQ2
        O     C
       CX   OQ1
  [ impropers ]
       CX   OQ1   OQ2    NZ
        N    -C    CA    HN
        C    CA    +N     O
  [ cmap ]
       -C     N    CA     C    +N

